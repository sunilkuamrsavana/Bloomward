{
  "name": "bloomward-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "test": "vitest run",
    "check": "npm run types && npm run typecheck && npm test",
    "deploy:dry-run": "wrangler deploy --env production --dry-run",
    "deploy:production": "wrangler deploy --env production"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.2.1",
    "@types/node": "24.13.6",
    "typescript": "7.0.2",
    "vite": "^7.0.0",
    "vitest": "4.1.11",
    "wrangler": "4.136.1"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "standardwebhooks": "^1.1.1",
    "zod": "^4.6.5"
  }
}
